<?xml version="1.0"?>
<package format="2">
  <name>px4_basic_control</name>
  <version>0.1.0</version>
  <description>Minimal guarded PX4 OFFBOARD takeoff, hover, and AUTO.LAND controller.</description>

  <maintainer email="uav@example.com">UAV Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>rostest</test_depend>
  <test_depend>rosunit</test_depend>
</package>
