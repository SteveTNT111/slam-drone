<launch>
    <arg name="obj_num" default="0" />
    <arg name="drone_id" default="0"/>

    <!-- Keep the first indoor tests small. Goals must stay inside +/- map_size/2. -->
    <arg name="map_size_x" default="20"/>
    <arg name="map_size_y" default="20"/>
    <arg name="map_size_z" default="3.0"/>

    <!-- FAST-LIO2 publishes these by default in the current workspace. -->
    <arg name="odom_topic" default="/Odometry"/>
    <arg name="cloud_topic" default="/cloud_registered"/>

    <!-- Conservative first-flight limits. Raise only after planner/control logs look clean. -->
    <arg name="max_vel" default="0.5" />
    <arg name="max_acc" default="2.0" />
    <arg name="planning_horizon" default="5.0" />

    <!-- MID360 point cloud mapping params for EGO's local occupancy grid. -->
    <arg name="resolution" default="0.15"/>
    <arg name="obstacles_inflation" default="0.30"/>
    <arg name="local_update_range_x" default="5.5"/>
    <arg name="local_update_range_y" default="5.5"/>
    <arg name="local_update_range_z" default="3.0"/>
    <arg name="ground_height" default="-0.05"/>
    <arg name="frame_id" default="world"/>

    <arg name="use_distinctive_trajs" default="false" />

    <!-- 1: RViz 2D Nav Goal, 2: fixed waypoints below. -->
    <arg name="flight_type" default="1" />
    <arg name="point_num" default="1" />
    <arg name="point0_x" default="3.0" />
    <arg name="point0_y" default="0.0" />
    <arg name="point0_z" default="1.0" />
    <arg name="point1_x" default="0.0" />
    <arg name="point1_y" default="0.0" />
    <arg name="point1_z" default="1.0" />
    <arg name="point2_x" default="0.0" />
    <arg name="point2_y" default="0.0" />
    <arg name="point2_z" default="1.0" />
    <arg name="point3_x" default="0.0" />
    <arg name="point3_y" default="0.0" />
    <arg name="point3_z" default="1.0" />
    <arg name="point4_x" default="0.0" />
    <arg name="point4_y" default="0.0" />
    <arg name="point4_z" default="1.0" />

    <include file="$(find ego_planner)/launch/advanced_param_fastlio.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="obj_num_set" value="$(arg obj_num)" />

        <!-- Use point cloud input. Depth-image inputs are intentionally unused. -->
        <arg name="camera_pose_topic" value="nouse_pose"/>
        <arg name="depth_topic" value="nouse_depth"/>
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>

        <!-- Kept only because advanced_param requires camera args; unused for cloud mode. -->
        <arg name="cx" value="0.0"/>
        <arg name="cy" value="0.0"/>
        <arg name="fx" value="1.0"/>
        <arg name="fy" value="1.0"/>

        <arg name="max_vel" value="$(arg max_vel)" />
        <arg name="max_acc" value="$(arg max_acc)" />
        <arg name="planning_horizon" value="$(arg planning_horizon)" />
        <arg name="resolution" value="$(arg resolution)" />
        <arg name="obstacles_inflation" value="$(arg obstacles_inflation)" />
        <arg name="local_update_range_x" value="$(arg local_update_range_x)" />
        <arg name="local_update_range_y" value="$(arg local_update_range_y)" />
        <arg name="local_update_range_z" value="$(arg local_update_range_z)" />
        <arg name="ground_height" value="$(arg ground_height)" />
        <arg name="frame_id" value="$(arg frame_id)" />
        <arg name="use_distinctive_trajs" value="$(arg use_distinctive_trajs)" />
        <arg name="flight_type" value="$(arg flight_type)" />

        <arg name="point_num" value="$(arg point_num)" />
        <arg name="point0_x" value="$(arg point0_x)" />
        <arg name="point0_y" value="$(arg point0_y)" />
        <arg name="point0_z" value="$(arg point0_z)" />
        <arg name="point1_x" value="$(arg point1_x)" />
        <arg name="point1_y" value="$(arg point1_y)" />
        <arg name="point1_z" value="$(arg point1_z)" />
        <arg name="point2_x" value="$(arg point2_x)" />
        <arg name="point2_y" value="$(arg point2_y)" />
        <arg name="point2_z" value="$(arg point2_z)" />
        <arg name="point3_x" value="$(arg point3_x)" />
        <arg name="point3_y" value="$(arg point3_y)" />
        <arg name="point3_z" value="$(arg point3_z)" />
        <arg name="point4_x" value="$(arg point4_x)" />
        <arg name="point4_y" value="$(arg point4_y)" />
        <arg name="point4_z" value="$(arg point4_z)" />
    </include>

    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="~planning/bspline" to="drone_$(arg drone_id)_planning/bspline"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>
</launch>
